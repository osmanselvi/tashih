# --- Yapay zekâ / AI -------------------------------------------------
# Boş bırakılırsa kural tabanlı (heuristic) analiz devreye girer.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Veritabanı / Database -------------------------------------------
# Varsayılan: sqlite:///./data/tashih.db (çalışma dizinine göre)
# DATABASE_URL=sqlite:///./data/tashih.db

# --- Depolama / Storage ----------------------------------------------
# DATA_DIR=./data

# --- Arayüz dili / UI language: tr | en ------------------------------
LANG=tr

# --- Maksimum PDF boyutu (MB) ----------------------------------------
MAX_UPLOAD_MB=50
